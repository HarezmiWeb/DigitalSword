@using System.Linq
@using ProductDto = DigitalSword.Application.DTOs.ProductResponseDto
@model IEnumerable<ProductDto>

@{
    ViewData["Title"] = "Ana Sayfa - DigitalSword";

    var allProducts = Model?.ToList() ?? new List<ProductDto>();

    // 1. Popüler Oyunlar (Game / DLC)
    var games = allProducts.Where(p => p.ProductType != null && (
        p.ProductType.ToString().Equals("Game", StringComparison.OrdinalIgnoreCase) ||
        p.ProductType.ToString().Equals("GameKey", StringComparison.OrdinalIgnoreCase) ||
        p.ProductType.ToString() == "1" ||
        p.ProductType.ToString() == "4" ||
        p.ProductType.ToString().Equals("DLC", StringComparison.OrdinalIgnoreCase)
    )).Take(4).ToList();

    // 2. E-Pin ve Oyun İçi Ürünler
    var epins = allProducts.Where(p => p.ProductType != null && (
        p.ProductType.ToString().Equals("Epin", StringComparison.OrdinalIgnoreCase) ||
        p.ProductType.ToString().Equals("E_Pin", StringComparison.OrdinalIgnoreCase) ||
        p.ProductType.ToString() == "2" ||
        p.ProductType.ToString().Equals("InGameItem", StringComparison.OrdinalIgnoreCase) ||
        p.ProductType.ToString() == "3"
    )).Take(4).ToList();

    // 3. Hediye Kartları
    var giftCards = allProducts.Where(p =>
        (!string.IsNullOrEmpty(p.Title) && p.Title.Contains("Kart", StringComparison.OrdinalIgnoreCase)) ||
        (!string.IsNullOrEmpty(p.Title) && p.Title.Contains("Google Play", StringComparison.OrdinalIgnoreCase)) ||
        (!string.IsNullOrEmpty(p.Title) && p.Title.Contains("Steam Cüzdan", StringComparison.OrdinalIgnoreCase)) ||
        (!string.IsNullOrEmpty(p.Title) && p.Title.Contains("Gift", StringComparison.OrdinalIgnoreCase))
    ).Take(4).ToList();
}

<style>
    /* Hero Banner */
    .hero-banner {
        background-color: #0b0f19;
        border: 1px solid #30363d;
        border-radius: 16px;
        overflow: hidden;
    }

    .hero-badge {
        background-color: rgba(245, 159, 0, 0.15);
        color: #f59f00;
        border: 1px solid rgba(245, 159, 0, 0.35);
        letter-spacing: 1px;
    }

    /* "Tümünü Gör" Butonu */
    .btn-see-all {
        background-color: #161b22;
        color: #f0f6fc;
        border: 1px solid #30363d;
        padding: 7px 20px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-see-all:hover {
            background-color: #21262d;
            color: #f59f00;
            border-color: #8b949e;
            transform: translateX(2px);
        }

    /* Ürün Kartı Stili */
    .product-card {
        background-color: #161b22;
        border: 1px solid #30363d;
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .product-card:hover {
            transform: translateY(-4px);
            border-color: #f59f00;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.45);
        }

    .product-thumb-wrapper {
        height: 180px;
        background-color: #0b0f19;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
        border-bottom: 1px solid #21262d;
    }

    .product-thumb-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .product-card:hover .product-thumb-img {
        transform: scale(1.05);
    }

    /* Güven Avantaj Kartları */
    .trust-card {
        background-color: #161b22;
        border: 1px solid #30363d;
        border-radius: 12px;
        padding: 1rem;
        transition: border-color 0.2s ease;
    }

        .trust-card:hover {
            border-color: #f59f00;
        }

    .btn-buy-action {
        transition: all 0.2s ease;
    }

        .btn-buy-action.added {
            background-color: #2fb344 !important;
            border-color: #2fb344 !important;
            color: #ffffff !important;
        }
</style>

<!-- HERO BANNER -->
<div class="hero-banner mb-5 shadow-sm">
    <div class="row g-0 align-items-center" style="min-height: 280px;">
        <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-center">
            <div>
                <span class="badge hero-badge px-3 py-1 text-uppercase fw-bold mb-3 d-inline-block">
                    Haftanın Fırsatları
                </span>
                <h1 class="display-6 fw-bold text-white mb-2">
                    En Popüler Oyunlar & Lisanslar
                </h1>
                <p class="text-secondary fs-6 mb-4">
                    Yetkili satıcı garantisiyle 7/24 anında dijital teslimat.
                </p>
                <a href="/kategori/oyunlar" class="btn btn-warning fw-bold px-4 py-2">
                    Oyunları Keşfet
                </a>
            </div>
        </div>

        <div class="col-lg-6 h-100 position-relative" style="min-height: 280px;">
            <img src="~/img/Images1.jpg"
                 alt="DigitalSword Kampanyalar"
                 class="w-100 h-100"
                 style="object-fit: cover; object-position: center right; position: absolute; top: 0; right: 0; -webkit-mask-image: linear-gradient(to left, black 70%, transparent 100%); mask-image: linear-gradient(to left, black 70%, transparent 100%);" />
        </div>
    </div>
</div>

<!-- GÜVEN VE AVANTAJ ŞERİDİ -->
<div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
        <div class="trust-card text-center h-100">
            <i class="ti ti-bolt fs-1 text-warning mb-2 d-block"></i>
            <h6 class="text-white fw-bold mb-1">Anında Teslimat</h6>
            <small class="text-secondary">7/24 otomatik kod gönderimi</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="trust-card text-center h-100">
            <i class="ti ti-shield-check fs-1 text-info mb-2 d-block"></i>
            <h6 class="text-white fw-bold mb-1">Güvenli Ödeme</h6>
            <small class="text-secondary">3D Secure & 256-Bit SSL</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="trust-card text-center h-100">
            <i class="ti ti-headset fs-1 text-warning mb-2 d-block"></i>
            <h6 class="text-white fw-bold mb-1">Hızlı Destek</h6>
            <small class="text-secondary">Uzman destek ekibi</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="trust-card text-center h-100">
            <i class="ti ti-certificate fs-1 text-info mb-2 d-block"></i>
            <h6 class="text-white fw-bold mb-1">%100 Orijinal</h6>
            <small class="text-secondary">Yetkili dağıtıcı lisansları</small>
        </div>
    </div>
</div>

<!-- BÖLÜM 1: POPÜLER OYUNLAR -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="h3 fw-bold text-white mb-1">Popüler Oyunlar</h2>
            <p class="text-secondary small mb-0">En çok oynanan AAA ve bağımsız PC yapımları.</p>
        </div>
        <a href="/kategori/oyunlar" class="btn-see-all">
            Tümünü Gör <i class="ti ti-arrow-right"></i>
        </a>
    </div>

    <div class="row g-4">
        @if (games.Any())
        {
            foreach (var item in games)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="product-card">
                        <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.Id" class="product-thumb-wrapper text-decoration-none">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/400x300/1e293b/white?text=DigitalSword" : item.ImageUrl)"
                                 class="product-thumb-img" alt="@item.Title" />
                        </a>
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <span class="text-secondary small mb-1">
                                <i class="ti ti-package me-1"></i>@(item.Stock > 0 ? $"{item.Stock} Adet Stokta" : "Tükendi")
                            </span>
                            <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.Id" class="text-white text-decoration-none fw-bold text-truncate mb-3" title="@item.Title">
                                @item.Title
                            </a>
                            <div class="mt-auto pt-3 border-top border-secondary d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-secondary d-block" style="font-size: 0.65rem;">Fiyat</span>
                                    <span class="fs-5 fw-bold text-warning">@item.Price.ToString("C2")</span>
                                </div>
                                <button type="button"
                                        onclick="handleAddToCart(@item.Id, this)"
                                        class="btn btn-warning btn-sm fw-bold px-3 btn-buy-action d-flex align-items-center gap-1">
                                    <i class="ti ti-shopping-cart-plus"></i>
                                    <span>Satın Al</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-3">Bu kategoride henüz ürün listelenmiyor.</div>
        }
    </div>
</section>

<!-- BÖLÜM 2: E-PIN & PAKETLER -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="h3 fw-bold text-white mb-1">E-Pin & Paketler</h2>
            <p class="text-secondary small mb-0">LoL RP, Valorant VP ve popüler oyun içi para birimleri.</p>
        </div>
        <a href="/kategori/epin" class="btn-see-all">
