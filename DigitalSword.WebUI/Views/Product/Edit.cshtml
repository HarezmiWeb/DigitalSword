@model DigitalSword.Application.DTOs.UpdateProductDto

@{
    Layout = "_LayoutAdmin";

    string productType = Model?.ProductType.ToString() ?? "Game";

    string pageTitle = productType switch
    {
        "GiftCard" => "Hediye Kartını Düzenle",
        "Epin" => "E-Pin / Paketi Düzenle",
        _ => "Oyunu Düzenle"
    };

    ViewData["Title"] = pageTitle;
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-white">
                <i class="ti @(productType == "GiftCard" ? "ti-gift text-cyan" : productType == "Epin" ? "ti-diamond text-info" : "ti-device-gamepad-2 text-warning") me-2"></i> @pageTitle
            </h2>
            <div class="text-muted mt-1">Ürün bilgilerini güncelleyin.</div>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Index" asp-route-type="@productType" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Listeye Dön
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9 col-md-11">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-header border-secondary">
                <h3 class="card-title text-white">Ürün Bilgilerini Düzenle (ID: @Model?.Id)</h3>
            </div>
            <form asp-action="Edit" method="post">
                <!-- ID ve ProductType Alanlarını Gizli Olarak Tutuyoruz -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProductType" value="@productType" />

                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Title" class="form-label text-white required">Ürün / Kart Adı</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-typography"></i>
                                </span>
                                <input asp-for="Title" class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Price" class="form-label text-white required">Satış Fiyatı (₺)</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-currency-lira"></i>
                                </span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label text-white required">Kategori</label>
                            <select asp-for="CategoryId" class="form-select bg-dark text-white border-secondary">
                                <option value="">-- Kategori Seçiniz --</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PublisherId" class="form-label text-white required">Yayıncı / Platform</label>
                            <select asp-for="PublisherId" class="form-select bg-dark text-white border-secondary">
                                <option value="">-- Yayıncı / Marka Seçiniz --</option>
                                @if (ViewBag.Publishers != null)
                                {
                                    foreach (var pub in ViewBag.Publishers)
                                    {
                                        <option value="@pub.Id">@pub.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PublisherId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="ImageUrl" class="form-label text-white">Görsel URL</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-photo"></i>
                                </span>
                                <input asp-for="ImageUrl" class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Stock" class="form-label text-white required">Stok Miktarı</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-box"></i>
                                </span>
                                <input asp-for="Stock" type="number" class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-white">Ürün Açıklaması & Teslimat Notları</label>
                        <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label text-white">Ürün Vitrinde Aktif Olarak Gösterilsin</label>
                    </div>
                </div>
                <div class="card-footer border-secondary bg-transparent d-flex justify-content-between align-items-center">
                    <a asp-action="Index" asp-route-type="@productType" class="btn btn-outline-secondary">İptal</a>
                    <button type="submit" class="btn btn-warning">
                        <i class="ti ti-device-floppy me-1"></i> Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}