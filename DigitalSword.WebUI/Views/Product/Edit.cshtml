@model DigitalSword.Application.DTOs.UpdateProductDto

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Oyunu Düzenle";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-white">
                <i class="ti ti-edit text-warning me-2"></i> Oyunu Düzenle
            </h2>
            <div class="text-muted mt-1">Mevcut oyunun fiyat, stok veya açıklama bilgilerini güncelleyin.</div>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Listeye Dön
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9 col-md-11">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                <h3 class="card-title text-white">Oyun Düzenleme (ID: @Model.Id)</h3>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="rounded border border-secondary" style="height: 40px; width: 60px; object-fit: cover;" />
                }
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <!-- Oyun Adı -->
                        <div class="col-md-8 mb-3">
                            <label asp-for="Title" class="form-label text-white required">Oyun Adı</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-typography"></i>
                                </span>
                                <input asp-for="Title" class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Fiyat -->
                        <div class="col-md-4 mb-3">
                            <label asp-for="Price" class="form-label text-white required">Fiyat (₺)</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-currency-lira"></i>
                                </span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Kategori Seçimi -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label text-white required">Kategori</label>
                            <select asp-for="CategoryId" class="form-select bg-dark text-white border-secondary">
                                <option value="">-- Kategori Seçiniz --</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        if (cat.Id == Model.CategoryId)
                                        {
                                            <option value="@cat.Id" selected>@cat.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    }
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Yayıncı Seçimi -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="PublisherId" class="form-label text-white required">Yayıncı / Firma</label>
                            <select asp-for="PublisherId" class="form-select bg-dark text-white border-secondary">
                                <option value="">-- Yayıncı Seçiniz --</option>
                                @if (ViewBag.Publishers != null)
                                {
                                    foreach (var pub in ViewBag.Publishers)
                                    {
                                        if (pub.Id == Model.PublisherId)
                                        {
                                            <option value="@pub.Id" selected>@pub.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@pub.Id">@pub.Name</option>
                                        }
                                    }
                                }
                            </select>
                            <span asp-validation-for="PublisherId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Kapak Resmi URL -->
                        <div class="col-md-8 mb-3">
                            <label asp-for="ImageUrl" class="form-label text-white">Görsel URL</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-photo"></i>
                                </span>
                                <input asp-for="ImageUrl" class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <!-- Stok -->
                        <div class="col-md-4 mb-3">
                            <label asp-for="Stock" class="form-label text-white required">Stok</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-box"></i>
                                </span>
                                <input asp-for="Stock" type="number" class="form-control bg-dark text-white border-secondary" />
                            </div>
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Açıklama -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-white">Açıklama</label>
                        <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="card-footer border-secondary bg-transparent d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-warning">
                        <i class="ti ti-refresh me-1"></i> Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}