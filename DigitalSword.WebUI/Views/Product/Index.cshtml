@model List<DigitalSword.Application.DTOs.ProductResponseDto>

@{
    Layout = "_LayoutAdmin";
    // Controller'dan gelen dinamik başlık varsa onu kullan, yoksa varsayılanı yaz
    ViewData["Title"] = ViewBag.PageTitle ?? "Ürün Yönetimi";
    string currentType = ViewBag.CurrentType as string ?? "";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>⚔️ @ViewData["Title"]</h2>
        <!-- Yeni ürün eklerken hangi sekmedeyse (örn: GiftCard) türü query string ile form sayfasına aktarıyoruz -->
        <a asp-controller="Product" asp-action="Create" asp-route-type="@currentType" class="btn btn-success">+ Yeni Ürün Ekle</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 60px;">ID</th>
                <th>Başlık</th>
                <th>Açıklama</th>
                <th style="width: 130px;">Fiyat</th>
                <th style="width: 90px;">Stok</th>
                <th style="width: 180px;" class="text-center">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Bu kategoride henüz ürün bulunmuyor.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>@item.Price.ToString("C2")</td>
                        <td>@item.Stock</td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    Düzenle
                                </a>

                                <form asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" asp-route-returnType="@currentType" method="post" onsubmit="return confirm('@item.Title adlı ürünü silmek istediğinize emin misiniz?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Sil
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>