@model DigitalSword.Application.DTOs.CreateProductDto

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Yeni Oyun Ekle";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-white">
                <i class="ti ti-device-gamepad-2 text-warning me-2"></i> Yeni Oyun Ekle
            </h2>
            <div class="text-muted mt-1">Mağazaya yeni bir dijital oyun veya epin ürünü tanımlayın.</div>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Listeye Dön
            </a>
        </div>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-lg-9 col-md-11">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-header border-secondary">
                <h3 class="card-title text-white">Oyun Genel Bilgileri</h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Title" class="form-label text-white required">Oyun Adı</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-typography"></i>
                                </span>
                                <input asp-for="Title" class="form-control bg-dark text-white border-secondary" placeholder="Örn: Cyberpunk 2077, Elden Ring, GTA V" autofocus />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Price" class="form-label text-white required">Satış Fiyatı (₺)</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-currency-lira"></i>
                                </span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label text-white required">Kategori</label>
                            <select asp-for="CategoryId" class="form-select bg-dark text-white border-secondary">
                                <option value="">-- Kategori Seçiniz --</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PublisherId" class="form-label text-white required">Yayıncı / Firma</label>
                            <select asp-for="PublisherId" class="form-select bg-dark text-white border-secondary">
                                <option value="">-- Yayıncı Seçiniz --</option>
                                @if (ViewBag.Publishers != null)
                                {
                                    foreach (var pub in ViewBag.Publishers)
                                    {
                                        <option value="@pub.Id">@pub.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PublisherId" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="ImageUrl" class="form-label text-white">Görsel URL</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-photo"></i>
                                </span>
                                <input asp-for="ImageUrl" class="form-control bg-dark text-white border-secondary" placeholder="https://... (Oyun kapak afişi linki)" />
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Stock" class="form-label text-white required">Başlangıç Stok</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <i class="ti ti-box"></i>
                                </span>
                                <input asp-for="Stock" type="number" class="form-control bg-dark text-white border-secondary" placeholder="0" />
                            </div>
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-white">Oyun Açıklaması & Detaylar</label>
                        <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="5" placeholder="Oyunun hikayesi, sistem gereksinimleri veya aktivasyon notları..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
                <div class="card-footer border-secondary bg-transparent d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    <button type="submit" class="btn btn-warning">
                        <i class="ti ti-plus me-1"></i> Oyunu Ekle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}