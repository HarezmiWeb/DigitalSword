@model DigitalSword.Application.DTOs.CreateCategoryDto

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-white">
                <i class="ti ti-category text-primary me-2"></i> Yeni Kategori Ekle
            </h2>
            <div class="text-muted mt-1">Sistemdeki ürünleri gruplamak için yeni kategori tanımlayın.</div>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Listeye Dön
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-header border-secondary">
                <h3 class="card-title text-white">Kategori Detayları</h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label text-white required">Kategori Adı</label>
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-tag"></i>
                            </span>
                            <input asp-for="Name" class="form-control bg-dark text-white border-secondary" placeholder="Örn: RPG, Aksiyon, Simülasyon, FPS" autofocus />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-white">Açıklama</label>
                        <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="4" placeholder="Kategori içeriğini açıklayan kısa metin..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
                <div class="card-footer border-secondary bg-transparent d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
