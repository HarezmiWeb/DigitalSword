@model DigitalSword.Application.DTOs.UpdatePublisherDto

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Yayıncıyı Düzenle";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-white">
                <i class="ti ti-edit text-warning me-2"></i> Yayıncıyı Düzenle
            </h2>
            <div class="text-muted mt-1">Mevcut yayıncı bilgilerini güncelleyin.</div>
        </div>
        <div class="col-auto ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Listeye Dön
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-header border-secondary">
                <h3 class="card-title text-white">Yayıncı Bilgileri (ID: @Model.Id)</h3>
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label text-white required">Yayıncı / Şirket Adı</label>
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-building"></i>
                            </span>
                            <input asp-for="Name" class="form-control bg-dark text-white border-secondary" placeholder="Yayıncı adı giriniz" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-white">Açıklama</label>
                        <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="4" placeholder="Açıklama giriniz..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
                <div class="card-footer border-secondary bg-transparent d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-warning">
                        <i class="ti ti-refresh me-1"></i> Güncelle
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}