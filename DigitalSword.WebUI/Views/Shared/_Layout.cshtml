@using DigitalSword.WebUI.Extensions
@using DigitalSword.WebUI.Models
@inject IHttpContextAccessor HttpContextAccessor

@{
    var sessionCart = HttpContextAccessor.HttpContext?.Session.GetObject<List<CartItemViewModel>>("DigitalSword_Cart");
    var initialCartCount = sessionCart?.Sum(x => x.Quantity) ?? 0;
}

<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - DigitalSword</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            body {
                background-color: #0b0f19;
                color: #e2e8f0;
            }

            .navbar-store {
                background-color: #111827 !important;
                border-bottom: 1px solid #1f2937;
            }

            .footer-store {
                background-color: #111827;
                border-top: 1px solid #1f2937;
            }

            /* Sepet İkonu ve Sayaç Rozeti */
            .btn-nav-cart {
                position: relative;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 8px 12px;
                color: #cbd5e1;
                text-decoration: none;
                border-radius: 8px;
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid #374151;
                transition: all 0.2s ease;
            }

                .btn-nav-cart:hover {
                    color: #f59f00;
                    border-color: #f59f00;
                }

            .cart-badge {
                position: absolute;
                top: -6px;
                right: -6px;
                background-color: #f59f00;
                color: #000;
                font-weight: 700;
                font-size: 0.75rem;
                min-width: 20px;
                height: 20px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2px;
                transition: transform 0.2s ease, background-color 0.2s ease;
            }

                .cart-badge.bump {
                    transform: scale(1.3);
                    background-color: #ef4444;
                    color: #fff;
                }

            @@media (min-width: 768px) {
                .navbar-nav .nav-item.dropdown:hover > .dropdown-menu {
                    display: block;
                    margin-top: 0;
                }

                .navbar-nav .dropdown-menu::before {
                    content: "";
                    position: absolute;
                    top: -10px;
                    left: 0;
                    width: 100%;
                    height: 10px;
                    display: block;
                }
            }

            .dropdown-menu {
                background-color: #161b26 !important;
                border: 1px solid #374151 !important;
                border-radius: 8px !important;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;
                z-index: 9999 !important;
            }

            .dropdown-item {
                color: #cbd5e1 !important;
                padding: 8px 16px !important;
                transition: all 0.15s ease-in-out;
            }

                .dropdown-item:hover {
                    background-color: #1f2937 !important;
                    color: #f59e0b !important;
                    padding-left: 20px !important;
                }

            @@media (min-width: 992px) {
                .custom-nav-dropdown:hover > .dropdown-menu {
                    display: block;
                    margin-top: 0;
                }
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="navbar navbar-expand-md navbar-dark navbar-store sticky-top">
        <div class="container-xl">
            <a class="navbar-brand text-decoration-none fw-bold fs-3 text-warning" href="/">
                ⚔️ DigitalSword
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbar-menu">
                @await Component.InvokeAsync("NavbarMenu")

                <!-- SAĞ AKSİYON BÖLGESİ -->
                <div class="nav-actions-group ms-auto mt-3 mt-md-0 d-flex align-items-center gap-2">
                    <!-- Sepet Butonu -->
                    <a href="/Cart" class="btn-nav-cart" title="Sepetim">
                        <i class="ti ti-shopping-cart fs-3"></i>
                        <span class="cart-badge" id="cart-count">@initialCartCount</span>
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a href="/Product" class="btn-nav-admin">
                                <i class="ti ti-dashboard"></i>
                                <span>Admin Paneli</span>
                            </a>
                        }

                        <div class="nav-user-chip d-flex align-items-center gap-2 px-3 py-1 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid #374151;">
                            <i class="ti ti-user-circle fs-3 text-secondary"></i>
                            <span class="nav-user-email text-light small">@User.Identity.Name</span>
                            <a href="/Auth/Logout" class="btn-nav-logout text-danger text-decoration-none ms-2" title="Oturumu Kapat">
                                <i class="ti ti-power me-1"></i>Çıkış
                            </a>
                        </div>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="btn-outline-action px-3 py-1 text-decoration-none d-inline-flex align-items-center">
                            <i class="ti ti-login me-1"></i> Giriş Yap
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow-1 py-4">
        <div class="container-xl">
            @RenderBody()
        </div>
    </main>

    <footer class="footer-store text-muted py-4 mt-auto">
        <div class="container-xl text-center">
            <div class="fw-bold text-white mb-1">⚔️ DigitalSword - E-Pin & Dijital Oyun Mağazası</div>
            <div class="small">© 2026 Tüm Hakları Saklıdır. Güvenli Ödeme ve Anında Teslimat.</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>
    <script>
            function addToCart(productId) {
                fetch('/Cart/AddToCart/' + productId, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(response => {
                        if (!response.ok) throw new Error('Hata oluştu');
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            const badge = document.getElementById('cart-count');
                            if (badge) {
                                badge.innerText = data.totalCount;
                                badge.classList.add('bump');
                                setTimeout(() => badge.classList.remove('bump'), 300);
                            }
                        }
                    })
                    .catch(err => console.error("Sepete ekleme hatası:", err));
            }

            document.addEventListener("DOMContentLoaded", function () {
                const parentDropdownLinks = document.querySelectorAll('.custom-nav-dropdown > a.nav-link');

                parentDropdownLinks.forEach(function (link) {
                    link.addEventListener('click', function (e) {
                        const targetUrl = this.getAttribute('href');
                        if (targetUrl && targetUrl !== '#' && window.innerWidth >= 992) {
                            window.location.href = targetUrl;
                        }
                    });
                });
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>