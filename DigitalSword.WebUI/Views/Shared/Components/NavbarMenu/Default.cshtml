@model IEnumerable<DigitalSword.Application.DTOs.MenuItemResponseDto>

<ul class="navbar-nav align-items-center">
    @foreach (var item in Model.Where(m => m.ParentId == null))
    {
        var hasSub = item.SubMenus != null && item.SubMenus.Any();

        if (!hasSub)
        {
            <li class="nav-item">
                <a class="nav-link text-white" href="@item.Url">
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <i class="@item.Icon me-1"></i>
                    }
                    @item.Title
                </a>
            </li>
        }
        else
        {
            <li class="nav-item dropdown custom-nav-dropdown">
                <a class="nav-link dropdown-toggle text-white" href="@item.Url">
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <i class="@item.Icon me-1"></i>
                    }
                    @item.Title
                </a>

                <div class="dropdown-menu dropdown-menu-dark bg-dark border-secondary shadow-lg">
                    @foreach (var sub in item.SubMenus)
                    {
                        <a class="dropdown-item text-white py-2" href="@sub.Url">
                            @if (!string.IsNullOrEmpty(sub.Icon))
                            {
                                <i class="@sub.Icon me-2 text-warning"></i>
                            }
                            @sub.Title
                        </a>
                    }
                </div>
            </li>
        }
    }
</ul>