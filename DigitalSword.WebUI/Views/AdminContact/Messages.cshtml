@model IEnumerable<DigitalSword.Application.DTOs.ContactMessageDto>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Gelen İletişim Mesajları";
}

<div class="page-header d-print-none mb-4">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title text-white">
                <i class="ti ti-mail text-info me-2"></i> Gelen İletişim Mesajları
            </h2>
            <div class="text-muted mt-1">Kullanıcıların "Bize Ulaşın" formu üzerinden gönderdiği mesajları buradan takip edebilirsiniz.</div>
        </div>
    </div>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="text-white">Gönderen</th>
                        <th class="text-white">E-Posta</th>
                        <th class="text-white">Konu</th>
                        <th class="text-white">Tarih</th>
                        <th class="text-end text-white">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-white">@item.SenderName</td>
                                <td><a href="mailto:@item.SenderEmail" class="text-info">@item.SenderEmail</a></td>
                                <td>@item.Subject</td>
                                <td class="text-muted">@item.SentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <!-- Detay veya Silme butonları eklenebilir -->
                                    <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#messageModal-@item.Id">
                                        <i class="ti ti-eye"></i> Oku
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz gelen bir iletişim mesajı bulunmuyor.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
