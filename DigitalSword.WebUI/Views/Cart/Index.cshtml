@model List<DigitalSword.WebUI.Models.CartItemViewModel>
@{
    ViewData["Title"] = "Sepetim";
}

<div class="container py-5">
    <h2 class="text-white fw-bold mb-4"><i class="ti ti-shopping-cart me-2"></i>Sepetiniz</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card bg-dark border-secondary p-3">
                    @foreach (var item in Model)
                    {
                        <div class="d-flex align-items-center justify-content-between py-3 border-bottom border-secondary">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@item.ImageUrl" style="width: 70px; height: 50px; object-fit: contain; background: #000; border-radius: 6px;" />
                                <div>
                                    <h6 class="text-white mb-0">@item.Title</h6>
                                    <small class="text-secondary">Adet: @item.Quantity</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-4">
                                <span class="text-warning fw-bold fs-5">@item.Total.ToString("C2")</span>
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button class="btn btn-outline-danger btn-sm"><i class="ti ti-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card bg-dark border-secondary p-4">
                    <h5 class="text-white fw-bold mb-3">Sipariş Özeti</h5>
                    <div class="d-flex justify-content-between text-secondary mb-2">
                        <span>Ara Toplam</span>
                        <span>@Model.Sum(x => x.Total).ToString("C2")</span>
                    </div>
                    <hr class="border-secondary" />
                    <div class="d-flex justify-content-between text-white fw-bold fs-5 mb-4">
                        <span>Toplam</span>
                        <span class="text-warning">@Model.Sum(x => x.Total).ToString("C2")</span>
                    </div>
                    <form asp-action="Checkout" method="post">
                        <button class="btn btn-warning w-100 fw-bold py-2">
                            <i class="ti ti-shield-check me-1"></i> Siparişi Tamamla & Key Al
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <p class="text-secondary fs-5">Sepetinizde ürün bulunmamaktadır.</p>
            <a href="/" class="btn btn-warning fw-bold">Alışverişe Başla</a>
        </div>
    }
</div>